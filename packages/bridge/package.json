{
  "name": "@jatinkumar-patel/devassist-bridge",
  "version": "0.1.0",
  "description": "Local bridge for DevAssist UI — handles SNOW NTLM auth and ADO proxying.",
  "main": "dist/index.js",
  "bin": {
    "devassist-bridge": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "devassist",
    "altera",
    "snow",
    "ado",
    "triage"
  ],
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "open": "^10.1.0",
    "serve-static": "^1.15.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/serve-static": "^1.15.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
